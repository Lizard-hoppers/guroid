# Скопировать в .env (рядом с bot.py) и заполнить.
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Юзернейм бота без @ — нужен guro_id_api.py для сборки QR-дипссылок
# GURO ID (t.me/<BOT_USERNAME>?start=guro_<id>). По умолчанию
# GamblingCommunitybot, менять только при смене юзернейма бота.
BOT_USERNAME=GamblingCommunitybot
BASE_DIR=/opt/gambling_community_bot
DATABASE_PATH=/opt/gambling_community_bot/gambling_community.sqlite3

# Кому слать новые анкеты и кто может /export /stats (через запятую)
ADMIN_IDS=

# ЗАГЛУШКА: ссылка-приглашение в сообщество (блок 7), фолбэк если COMMUNITY_CHAT_ID
# не задан или Bot API не смог создать ссылку. Заменить на t.me/+...
COMMUNITY_INVITE_URL=https://t.me/GamblingCommunitybot

# ID группы сообщества (-100xxxxxxxxxx). Если задан — после анкеты юзеру выдаётся
# ОДНОРАЗОВАЯ инвайт-ссылка (member_limit=1, сгорает после первого входа) вместо
# статичной COMMUNITY_INVITE_URL. Бот должен быть админом группы с правом Invite Users.
COMMUNITY_CHAT_ID=

# Google Sheets (пока выключено — нет ID таблицы). Включить: true + ID таблицы.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Анкеты
GOOGLE_SHEETS_CREDENTIALS_PATH=/opt/gambling_community_bot/google-service-account.json

# Капча для новичков в группе (второй уровень). Бот должен быть админом группы
# с правом «Banning users» (restrict). Тексты/ссылки/видео — в /admin (CMS).
CAPTCHA_ENABLED=true
# Кол-во вариантов-кнопок под примером (>=2).
CAPTCHA_OPTIONS=4
# Необязательный белый список ID групп (через запятую). Пусто = любые группы,
# куда добавлен бот. ID супергруппы выглядит как -100xxxxxxxxxx.
CAPTCHA_GROUP_IDS=

# Новости индустрии (RSS -> GPT -> модерация -> публикация), 16.07.2026.
# Публикация: черновик уходит всем ADMIN_IDS с кнопками Опубликовать/Отклонить.
NEWS_ENABLED=false
NEWS_CHAT_ID=
NEWS_TOPIC_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Сплетни/инсайды от участников (/gossip), 17.07.2026. Публикуются в тот же
# чат, что и новости (NEWS_CHAT_ID выше), но в СВОЮ тему (GOSSIP_TOPIC_ID, если
# группа с топиками) — не в тему новостей. Использует тот же
# OPENAI_API_KEY/OPENAI_MODEL. Вкл/выкл — тумблер в /admin.
GOSSIP_TOPIC_ID=

# GURO ID Mini App API (guro_id_api.py), отдельный процесс/сервис.
GURO_ID_API_PORT=8092

# Публичный URL GURO ID Mini App (Menu Button). По умолчанию — sslip.io-
# поддомен из config.py, переопределить при переходе на купленный домен.
GURO_ID_WEBAPP_URL=https://guro-app.193.111.62.16.sslip.io/

# CryptoBot (Crypto Pay API) — оплата подписки GURO ID в крипте (USDT),
# альтернатива Stars. Получить: открыть @CryptoBot в Telegram -> Crypto Pay
# -> My Apps -> Create App -> скопировать API-токен. Пусто = крипто-оплата
# выключена (эндпойнты /api/subscribe/crypto и /api/crypto/webhook отдают
# 503). После получения токена ТАКЖЕ нужно в дашборде приложения CryptoBot
# включить вебхуки и указать URL:
# https://guro-app.193.111.62.16.sslip.io/api/crypto/webhook
CRYPTOBOT_API_TOKEN=

# 29.08.2026 — второй токен/приложение CryptoBot (опционально). Если оба
# заданы, новые инвойсы распределяются кольцом 5:1 (5 инвойсов на этот,
# 1 на CRYPTOBOT_API_TOKEN выше) — см. guro_id_api._pick_crypto_token.
# У ЭТОГО приложения в его дашборде CryptoBot тоже нужно включить вебхуки
# на тот же URL (см. выше) — иначе оплаты через этот токен не долетят.
CRYPTOBOT_API_TOKEN_NEW=
